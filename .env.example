# Copy to .env and fill in what you have. Everything is optional: with nothing set, Sauda runs in
# fixture mode (PayPal simulated locally) with offline rule-based agents.

# --- PayPal (SANDBOX ONLY) -------------------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app. See KEYS_NEEDED.md.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app's Webhooks section (needed to verify webhook signatures when deployed).
PAYPAL_WEBHOOK_ID=
# Must stay "sandbox". Any other value stops the app.
PAYPAL_ENV=sandbox
# auto = sandbox when both keys are set, otherwise fixture. Force with "fixture" or "sandbox".
SAUDA_PAYPAL_MODE=auto

# Sandbox accounts (Dashboard > Testing Tools > Sandbox Accounts)
# Personal (buyer) account email: receives the balance invoice.
SAUDA_BUYER_EMAIL=
# Business accounts that play the FPOs and receive Payouts, as ID=email pairs.
# Without these, payouts go to placeholder addresses and show as UNCLAIMED in the sandbox.
SAUDA_SELLER_EMAILS=MMF=,ETG=,IDK=

# Where PayPal sends the buyer back after approval (your local URL or deployed URL).
SAUDA_PUBLIC_BASE_URL=http://localhost:8000

# --- AI: Nebius Token Factory (OpenAI-compatible) ---------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
SAUDA_LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
SAUDA_LLM_SELLER_MODEL=google/gemma-3-27b-it
SAUDA_LLM_FAST_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Or point at another .env that already holds NEBIUS_API_KEY (only that key is read from it).
SAUDA_EXTRA_ENV_FILE=
# Set to 1 to force the offline rule-based agents even when a key is present.
SAUDA_OFFLINE=0

# --- Safety knobs ------------------------------------------------------------------------------
# 1 = block every money-moving action (kill switch).
SAUDA_PAYMENTS_FROZEN=0
# Platform fee kept from FPO releases (covers PayPal fees).
SAUDA_PLATFORM_FEE_PCT=0.02
# Most a deal may release automatically under mandate rules before every release needs a human.
SAUDA_AUTO_RELEASE_DAILY_CAP=600
# Mandate signing secret. If empty, a random one is created in var/mandate_secret.
SAUDA_SECRET=
