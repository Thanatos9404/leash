# Copy to .env and fill in what you have. Everything is optional: with nothing set, Leash runs in fixture mode
# (PayPal simulated in-process and labelled as such) with offline rule-based agents. See KEYS_NEEDED.md.
# These are exactly the variables leash/config.py reads. Never put live PayPal credentials here.

# --- PayPal (SANDBOX ONLY) ---------------------------------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app's Webhooks section (needed to verify webhook signatures when deployed).
PAYPAL_WEBHOOK_ID=
# Must stay "sandbox". Any other value stops the app at startup.
PAYPAL_ENV=sandbox
# auto = sandbox when both credentials are set, otherwise fixture. Force with "fixture" or "sandbox".
LEASH_PAYPAL_MODE=auto
# Optional: the sandbox Personal (buyer) account email, shown on receipts.
LEASH_BUYER_EMAIL=

# Where PayPal sends the buyer back after approval (your local URL or deployed URL).
LEASH_PUBLIC_BASE_URL=http://localhost:8000
# Set automatically by Render; used only when LEASH_PUBLIC_BASE_URL is empty. Don't set it yourself.
# RENDER_EXTERNAL_URL=

# --- AI: Nebius Token Factory (OpenAI-compatible) ----------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Or point at another .env that already holds NEBIUS_API_KEY (only that one key is read from it).
LEASH_EXTRA_ENV_FILE=
# Mandate compiler and shopping agent.
LEASH_LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Dispute evidence statements.
LEASH_LLM_WRITER_MODEL=google/gemma-3-27b-it
# One retry on this model when a call fails.
LEASH_LLM_FAST_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Seconds per model call, and how many calls may run at once.
LEASH_LLM_TIMEOUT=30
LEASH_LLM_CONCURRENCY=4
# Set to 1 to force the offline rule-based agents even when a key is present.
LEASH_OFFLINE=0

# --- Product search (optional) -----------------------------------------------------------------------------
# Without a key the agent shops the fictional demo storefronts in data/catalog.json.
CHANNEL3_API_KEY=

# --- App -----------------------------------------------------------------------------------------------------
# 1 = refuse every capture and new authorization from startup (the global kill switch).
LEASH_PAYMENTS_FROZEN=0
# 1 = allow POST /api/demo/reset in sandbox mode too (it is always allowed in fixture mode).
LEASH_ALLOW_RESET=0
# Where the database and keys live. Leave commented out for the default, <repo>/var (an empty value would
# mean the current directory).
# LEASH_DATA_DIR=var
# The demo owner's display name. Leave commented out for the default (an empty value shows a blank name).
# LEASH_OWNER_NAME=Yashvardhan
